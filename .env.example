# Copy this file to .env before running docker compose.

MYSQL_IMAGE=mysql:8.4.11
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=agent_demo_root
SALES_DATABASE=agent_demo_sales
NACOS_DATABASE=nacos_config
MYSQL_USER=agent_demo
MYSQL_PASSWORD=agent_demo

# The slim image supports both Intel and Apple Silicon Macs.
NACOS_IMAGE=nacos/nacos-server:v3.2.3-slim
NACOS_CONSOLE_PORT=8080
NACOS_SERVER_PORT=8848
NACOS_GRPC_PORT=9848

# Local development only. Enable authentication and replace all values before
# adapting this Compose file for a shared or production environment.
NACOS_AUTH_ENABLE=false
NACOS_AUTH_IDENTITY_KEY=agent-demo-server
NACOS_AUTH_IDENTITY_VALUE=agent-demo-local-development
NACOS_AUTH_TOKEN=

NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=256m
